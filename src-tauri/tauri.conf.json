{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sitrep",
  "version": "0.4.3",
  "identifier": "io.github.samuelwoniowei.sitrep",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Sitrep",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "worker-src": "'none'",
        "media-src": "'none'"
      },
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A calm, private daily cybersecurity brief",
    "longDescription": "Three stories a day in plain English, a weekly lab project, and a learning loop. Runs locally; no accounts, no tracking.",
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhERTYyRjhDMjE5ODdBN0UKUldSK2VwZ2hqQy9tamRwYWFqSkdBR0w5TzZiR1NZMzFBcFpydXNhQWdSU25JWWpwblY4ZmFLd0YK",
      "endpoints": [
        "https://github.com/SamuelWoniowei/Sitrep/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
